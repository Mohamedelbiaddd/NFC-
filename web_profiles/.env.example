# Environment variables for the public profile site (Vercel → Settings →
# Environment Variables, Production + Preview). generate-config.mjs turns them
# into dist/config.json at build time. Leave them unset to use config.json.
#
# Never put the service_role / sb_secret_ key here: the build rejects it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
